meta {
  name: createEquipment
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/equipment
  body: json
  auth: inherit
}

body:json {
  {
    "bicycleId": "{{bicycleId}}",
    "type": "HELMET",
    "name": "testhelmet4",
    "description": "123"
  }
}

script:post-response {
  if(res.body.id){
    bru.setVar("equipmentId", res.body.id);
  }
}
